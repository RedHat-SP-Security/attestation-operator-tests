summary: Deployment test of attestation operator
description: Verify that the attestation operator deploys successfully by checking that the keylime-tenant, keylime-verifier, and keylime-registrar pods start, reach the Running state, and remain running.
contact: Sergio Arroutbi <sarroutb@redhat.com>
component:
  - attestation-operator
test: ./runtest.sh
recommend:
  - attestation-operator
duration: 5m
enabled: true
tag:
  - NoRHEL6
  - NoRHEL7
  - NoRHEL8
  - Tier3
tier: '3'
adjust:
  - enabled: false
    when: distro < rhel-9
    continue: false
  - enabled: false
    when: distro == rhel-alt-7
    continue: false
id: 16e6ab96-c843-4368-80df-850dbe6d67e9
